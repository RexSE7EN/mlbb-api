// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Hero {
  id          String      @id @default(uuid())
  name        String
  role        Role[]  @default([UNDEFINED])
  description String?
  image       String?
  releaseDate DateTime @default(now())
  skills      Skill[]
  skins       Skin[]
  attributes  HeroAttribute?

  @@map("heroes")
}

enum Role {
  ASSASSIN
  FIGHTER
  MAGE
  MARKSMAN
  SUPPORT
  TANK
  UNDEFINED
}

model Skill {
  id          String      @id @default(uuid())
  name        String
  description String?
  image       String?
  cooldown    Float
  skillCost   Float
  heroId      String
  hero        Hero     @relation(fields: [heroId], references: [id])

  @@map("skills")
}

model Skin {
  id          String      @id @default(uuid())
  name        String
  releaseDate DateTime @default(now())
  image       String?
  heroId      String
  hero        Hero     @relation(fields: [heroId], references: [id])

  @@map("skins")
}

model HeroAttribute {
  id                String @id @default(uuid())
  heroId            String @unique
  hero              Hero   @relation(fields: [heroId], references: [id])

  hp                Float
  hpGrowth          Float?
  hpRegen           Float?
  mana              Float?
  manaGrowth        Float?
  manaRegen         Float?
  physicalAttack    Float?
  physicalAttackGrowth Float?
  magicPower        Float?
  physicalDefense   Float?
  magicDefense      Float?
  attackSpeed       Float?
  attackSpeedGrowth Float?
  movementSpeed     Float?
  attackRange       Float?

  @@map("hero_attributes")
}

model Item {
  id          String      @id @default(uuid())
  name        String
  description String?
  image       String?
  cost        Int
  cooldown    Float?
  attributes  ItemAttribute[]

  @@map("items")
}

enum ItemAttributeType {
  HP
  HP_REGEN
  MANA
  MANA_REGEN
  ADAPTIVE_ATTACK
  PHYSICAL_ATTACK
  PHYSICAL_DEFENSE
  MAGIC_POWER
  MAGIC_DEFENSE
  ATTACK_SPEED
  MOVEMENT_SPEED
  SLOW_REDUCTION 
  COOLDOWN_REDUCTION
  CRIT_RATE
  CRIT_CHANCE
  LIFE_STEAL
  HYBRID_LIFE_STEAL
  SPELL_VAMP
  MAGIC_PENETRATION 
}


enum BlessingType {
  ICE
  BLOODY
  FLAME
  ENCOURAGE
  FAVOUR
  DIRE_HIT
  CONCEAL
}
model Blessing {
  id          String      @id @default(uuid())
  name        String
  description String?
  image       String?
  type        BlessingType

  @@map("blessings")
}

enum ItemType {
  MAGIC     // For items that increase magic power
  PHYSICAL // For items that increase physical attack 
  DEFENSE  // For items that increase physical or magic defense
  MOVEMENT
}
model ItemAttribute {
  id          String      @id @default(uuid())
  itemId      String
  item        Item     @relation(fields: [itemId], references: [id])
  attribute   String
  value       Float
  type       ItemAttributeType

  @@map("item_attributes")
}
model Emblem {
  id              String      @id @default(uuid())
  name            String
  description     String?
  image           String?
  emblemTalents   EmblemTalent[]

  @@map("emblems")
}

model EmblemTalent {
  id          String      @id @default(uuid())
  name        String
  description String?
  image       String?
  emblemId    String
  emblem      Emblem   @relation(fields: [emblemId], references: [id])

  @@map("emblem_talents")
}

model Spell {
  id          String      @id @default(uuid())
  name        String
  description String?
  image       String?
  cooldown    Float

  @@map("spells")
}

model GameMode {
  id          String      @id @default(uuid())
  name        String
  description String?

  @@map("game_modes")
}

model Rank {
  id          String      @id @default(uuid())
  name        String
  description String?
  image       String?

  @@map("ranks")
}

model JungleCreep {
  id          String      @id @default(uuid())
  name        String
  description String?
  image       String?
  gold        Int
  hp          Float
  XP         Float  // Experience points awarded for defeating the jungle creep
  attack      Float
  physicalDefense Float
  magicDefense    Float
  firstSpawn   Float // Time in seconds for the first spawn of the jungle creep
  respawnTime Float  // Time in seconds for the jungle creep to respawn after being defeated
  reward      String?

  @@map("jungle_creeps")
}


// Tables
// Heroes, Skins, Items, Emblems, Spells, Game Modes,
// Ranks , Skills, Attributes, Attributes Types