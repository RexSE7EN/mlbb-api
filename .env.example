# Environment variables for the application
# Possible value : development, production
NODE_ENV=your-node_env

# Assign port number for the server to listen on
PORT=your-port

# Database connection string for PostgreSQL (from Neon)
# Timeout can be set in seconds, preferred is 10 and above if connection is failing
# Pooled connection for your application (add &connect_timeout and &pool_timeout at the end)
DATABASE_URL=your-database_url
# Direct (unpooled) connection for Prisma CLI (add &connect_timeout at the end)
DATABASE_URL_UNPOOLED=your-database_url_unpooled

# Rate limiting configuration
# Rate limit window in seconds (e.g., 60 for 60 sec)
# Rate limit max requests per window (e.g., 100 for 100 requests)
# safe environment variable names for rate limiting
RATE_LIMIT_WINDOW=your-rate_limit_window
RATE_LIMIT_MAX=your-rate_limit_max
